# Copie ce fichier en .env.local et remplis-le. Ne commite jamais .env.local.

# Généré par : node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Admin en ligne : token GitHub « fine-grained » limité à ce seul dépôt,
# permission Contents = Read and write (rien d'autre).
# Laisse vide en local pour écrire directement dans content/writeups.
GITHUB_TOKEN=
GITHUB_REPO=proprietaire/depot
GITHUB_BRANCH=main
